FrontendDesign.zip

# Duplicate of web/src/data/kev.json, which the app imports
/kev.json

# Local architecture working notes — reasoning and measurements, not shipped docs
ARCHITECTURE-DECISIONS.md

# Python bytecode
__pycache__/
*.pyc

# The task brief itself — Firmable's document, not ours to publish
Backend-architecture.md

# Design-tool export kept locally for reference, not part of the deliverable
waiting-on-form-answers/

# Local agent definitions
.claude/

# Personal planning notes
Planning_Document.pdf

# Accuracy evidence — sample data and probe scripts behind the measured
# precision and recall figures. Kept locally so it survives a temp cleanup,
# out of the deliverable like ARCHITECTURE-DECISIONS.md.
accuracy/
